{
  "name": "reshapex-knowledge-graph-animation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && pnpm typecheck:tools && vite build",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "generate-demo": "tsx tools/generate-demo/cli.ts",
    "promote-demo": "tsx tools/generate-demo/promote.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "build:screensaver": "vite build -c vite.screensaver.config.ts",
    "verify:screensaver": "pnpm build:screensaver && tsx tools/screensaver/verify-web.ts",
    "package:mac": "sh screensaver/mac/package.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "commander": "^15.0.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
